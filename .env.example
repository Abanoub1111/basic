GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MAX_CONCURRENCY=3
DATABASE_URL=postgresql+asyncpg://email_assistant:email_assistant@localhost:5433/email_assistant
DATABASE_ECHO=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
EMAILS_PER_MINUTE=20
LOGIN_IP_PER_MINUTE=10
LOGIN_EMAIL_PER_MINUTE=5
CLASSIFICATION_CACHE_ENABLED=true
CLASSIFICATION_CACHE_TTL_SECONDS=300
CLASSIFICATION_CACHE_MAX_ENTRIES=1000
# LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
